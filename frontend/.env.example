# ==============================================================================
# HaltLayer Environment Configuration
# ==============================================================================
# Production-ready for Vercel deployment and local development.
# Public variables (NEXT_PUBLIC_*) are bundled into the browser client.
# Private variables (without NEXT_PUBLIC_) are strictly accessible ONLY server-side.
# ==============================================================================

# --- Public Client Variables (Safe for Browser) ---

# Target GenLayer RPC endpoint.
# Defaults to StudioNet: https://studio.genlayer.com/api
# Testnet Bradbury: https://testnet-bradbury.genlayer.foundation
# Localnet: http://127.0.0.1:4000/api
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api

# Deployed HaltLayer Intelligent Contract address
NEXT_PUBLIC_HALT_LAYER_ADDRESS=0x0000000000000000000000000000000000000000

# Deployed DemoVault Intelligent Contract address
NEXT_PUBLIC_DEMO_VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# Chain Network Name ("studionet" | "testnet_bradbury" | "localnet")
NEXT_PUBLIC_NETWORK_NAME=studionet

# Polling interval for live on-chain contract state (in milliseconds)
NEXT_PUBLIC_POLL_INTERVAL_MS=3000

# --- Server-Side Only Variables (NEVER EXPOSED TO CLIENT) ---

# Private key for optional backend transaction relay / sponsor actions
# Used only in /api/tx route when transactions are signed by protocol relay.
# LEAVE EMPTY OR SET SECURELY IN VERCEL ENVIRONMENT VARIABLES DASHBOARD.
GENLAYER_RELAY_PRIVATE_KEY=
